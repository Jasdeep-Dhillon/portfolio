---
import { Icon } from "astro-icon/components";
import MainLayout from "~/layouts/MainLayout.astro";
import { getRepos } from "~/lib/api-github";
import type { Repo } from "~/lib/types";

const repos: Repo[] = await getRepos();
---
<title>Projects | Jasdeep Dhillon</title>
<MainLayout>
    <div class="mx-8">
        <ul class="grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
            { repos.map((repo) => (
                <li id={repo.id.toString()} class="bg-card border-2 p-4">
                    <div class="flex items-center gap-2">
                    <a href={`/project/${repo.name}`} class="font-pixelify text-2xl capitalize text-wrap">
                        {repo.name.replaceAll('-', ' ').replaceAll('_', ' ')}
                    </a>
                    <a href={repo.html_url} target="_blank" rel="noopener noreferrer" class="hover:underline text-xl font-bold">
                        <Icon name="streamline-pixel:interface-essential-hyperlink"/>
                    </a>
                    </div>
                    {repo.description && <p class="text-muted-foreground">{repo.description}</p>}
                </li>
            )) }
    </div>
</MainLayout>
