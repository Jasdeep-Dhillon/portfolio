---
import { Font } from "astro:assets";
import "~/styles/global.css";
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<link rel="sitemap" href="/sitemap-index.xml" />
<title>{title ?? "Jasdeep Dhillon"}</title>
<meta name="description" content="Learning Astro" />
<link rel="icon" type="x-icon" href="/favicon.png" />
<Font cssVariable="--font-pixelify" preload />
<Font cssVariable="--font-google-sans" preload />
