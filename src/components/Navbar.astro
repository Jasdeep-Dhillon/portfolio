---
const currentPath = Astro.url.pathname;
const navLinks = [
  {path: "/", label: "Home"},
  {path: "/projects", label: "Projects"},
  {path: "/about", label: "About"},
  {path: "/resume", label: "Resume"}
];
---
<nav class="m-auto lg:col-span-1 col-span-2">
    <ul class="flex justify-evenly font-semibold py-2 md:px-12 font-pixelify sm:text md:text-xl">
        {navLinks.map((link)=> (
          <li class=`${link.path === currentPath ? "border": ""} transition-all px-6 py-2 hover:bg-card`>
              <a href={link.path}>
                  {link.label}
              </a>
          </li>
          ))
        }
    </ul>
</nav>
